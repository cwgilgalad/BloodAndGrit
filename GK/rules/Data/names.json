    { "id": "noun-at-place", "pattern": "{noun} at {place}" },
    { "id": "what-keeps",    "pattern": "What {actor} {verb3}" },
    { "id": "what-keep",     "pattern": "What {actorp} {verb}" },
    { "id": "no-x-for-y",    "pattern": "No {noun} for {actor}" },
    { "id": "not-own",       "pattern": "A {bodynoun} Not {poss} Own" },
    { "id": "count-at",      "pattern": "{num} {plural} at {place}" },
    { "id": "the-that",      "pattern": "The {noun} That {verb3}" },
    { "id": "gerund",        "pattern": "{verbing} the {hardnoun}" },
    { "id": "gerund-who",    "pattern": "{verbing} {given} {surname}" },
    { "id": "where",         "pattern": "Where {actor} {verb3}" },
    { "id": "where-p",       "pattern": "Where {actorp} {verb}" },
    { "id": "and",           "pattern": "{hardnoun} and {hardnoun}" },
    { "id": "owner-noun",    "pattern": "{surname}'s {noun}" },
    { "id": "of-person",     "pattern": "The {noun} of {given} {surname}" },
    { "id": "everyone",      "pattern": "{adj} {noun} for {actor}" },
    { "id": "come-to",       "pattern": "Something {motion3} at {place}" },
    { "id": "bare-place",    "pattern": "{place}" },
    { "id": "dont",          "pattern": "Do Not {verb} the {hardnoun}" },
    { "id": "until",         "pattern": "Until {actor} {verb3}" },
    { "id": "how-many",      "pattern": "{num} {plural}" }
  ],

