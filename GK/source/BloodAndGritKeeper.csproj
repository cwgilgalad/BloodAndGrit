<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The software is named GritKeeper (renamed from "The Keeper's Table", 2026-07-18).
         The internal namespace stays BloodAndGritKeeper to keep embedded-resource names
         and the source tree stable; only the shipped identity changed. -->
    <AssemblyName>GritKeeper</AssemblyName>
    <RootNamespace>BloodAndGritKeeper</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- The ONLY version in the project. MainForm.AppVersion reads it back off the assembly,
         and package.ps1 names the release tag from the built exe's FileVersion — so this number
         is what ships, whatever any other file says. Bump it with every release. -->
    <Version>1.46.0</Version>

    <!-- The steer-skull-and-rifles emblem, as a real Windows icon: the exe's file icon
         in Explorer/desktop AND (embedded below) the in-app title-bar icon. Regenerate
         from assets/img20.png with the make_ico.py recipe if the emblem ever changes. -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Honest assembly metadata: unsigned exes with blank publisher/description fields are
         exactly what AV heuristics flag first. Filled in alongside Authenticode signing
         (sign.ps1) to keep Windows/Defender/Cortex warnings down on the published build. -->
    <Company>Cole Williams</Company>
    <Authors>Cole Williams</Authors>
    <Product>GritKeeper — Blood &amp; Grit</Product>
    <AssemblyTitle>GritKeeper — Blood &amp; Grit</AssemblyTitle>
    <Description>GritKeeper, the Keeper's companion app for the Blood &amp; Grit tabletop RPG: posse, dice, bestiary, encounters, tracker, generators, maps, character maker, reference, and session notes.</Description>
    <Copyright>© 2026 Cole Williams</Copyright>

    <!-- Ship as a self-contained, single-file Windows exe so the target machine needs NO
         .NET install (the runtime is bundled). These live in the project (not just the
         publish command line) so a publish can never silently regress to framework-dependent.
         Path handling uses AppContext.BaseDirectory, so session.json resolves beside the exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- v1.11.0 startup pass, MEASURED this time — the v1.10.0 pass reasoned about JIT in the
         abstract and made launch worse, which is what the user actually felt. Four publish
         configurations, timed on this laptop from Start-Process to a real MainWindowHandle,
         each first launch done on a brand-new copy of the exe so Defender's first-execution
         scan is included the way a freshly-downloaded release really behaves:

           config                    exe size   first launch   every launch after
           R2R + compression (v1.10.0)  73 MB      18.0 s            1.64 s
           R2R, no compression         172 MB      14.5 s            0.88 s
           no R2R, no compression      155 MB       5.1 s            1.00 s   <- shipping this

         Compression is the expensive one: the bundle's ~39 MB of native libraries must be
         inflated and written to %TEMP%\.net\GritKeeper on the first run of every new build,
         and Defender then scans what came out. ReadyToRun roughly doubles the payload that
         has to go through that, so the two together cost 13 seconds of one-time launch to buy
         0.12 s of steady-state — a bad trade for an app that is launched, not benchmarked.
         Dropping both makes the first launch 3.5x faster and steady launches 1.6x faster;
         tiered JIT covers what R2R was supposed to. The exe grows to ~155 MB on disk but the
         SHIPPED ZIP actually SHRINKS (65.0 MB vs 67.9 MB) — Deflate does the same job once,
         at download time, instead of on the user's clock at every install.
         Do not re-enable either of these without re-running that measurement.

         InvariantGlobalization stays: it drops the ICU culture load at startup and is safe
         here because every number the app writes (Pdf.cs / MapGen.cs coordinates) already goes
         through an explicit CultureInfo.InvariantCulture formatter, so comma-decimal locales
         can't corrupt an export. TieredPGO stays at its .NET 10 default (on).

         Also measured and REJECTED: IncludeNativeLibrariesForSelfExtract=false. It publishes
         and signs cleanly but the app never opens a window (timed out at 90 s) — WinForms
         self-contained single-file needs its native libraries extracted.
         (That last paragraph is net8.0 history — see the net10.0 note below, where it stops
         being true.) -->
    <!-- RE-CHECKED v1.39.0 (2026-08-15) and the answer did not move. Measured again on this
         machine: no-R2R 155.7 MB, 11.1 s first run, 3.35 s warm; R2R 173.0 MB, 15.7 s first run,
         2.88 s warm. Those warm figures are the SELF-TEST, not a window launch, and that is the
         whole reason they look kinder to R2R than the v1.10.0 row above: the self-test constructs
         all three run modes, all ten tabs, the thirteen-leaf deck and seventeen wizards, so it JITs a
         great deal of code a real launch never touches. The v1.10.0 numbers measured the thing a
         Keeper actually waits for and found 0.12 s saved against 9.4 s added on first run.
         Measure the launch, not the harness — a proxy that exercises more than the real path will
         always flatter whatever makes bulk JIT cheaper.

         RE-MEASURED ON net10.0-windows, v1.46.0 (2026-08-23), because the TFM bump was the one
         change that could plausibly overturn this: .NET 10 reworked single-file compression, and
         the whole case against it was a first-launch cost that no longer exists. Back to the
         v1.10.0 method — Start-Process to a real MainWindowHandle, a brand-new copy of the exe for
         every first-launch figure so Defender's first-execution scan is inside the number, three
         warm runs averaged:

           config                      exe on disk   shipped zip   first launch   every launch after
           no R2R, no compression         112.5 MB      45.9 MB        3.42 s           0.99 s   <- shipping this
           R2R, no compression            126.5 MB      50.8 MB        4.48 s           1.07 s
           compression, no R2R             50.0 MB      44.8 MB        3.32 s           1.23 s

         Both stay off, and one of the two reasons has changed underneath the answer.

         ReadyToRun is now worse on every axis at once — larger exe, larger download, slower first
         launch AND slower warm launch. Under .NET 8 it at least bought steady-state speed. It no
         longer buys anything, and this is the third measurement to reject it.

         Compression is the interesting one and the note above is now WRONG about why. Its 13-second
         first-launch penalty is gone: .NET 10 inflates the bundle so much faster that the compressed
         build actually starts marginally sooner cold (3.32 s vs 3.42 s, inside the noise). What it
         still costs is 0.24 s on EVERY launch after the first, and what it buys is 62.5 MB of disk
         and 1.1 MB of download. The zip is what a stranger actually waits on and 1.1 MB of it is
         nothing; the 0.24 s is paid by the Keeper every session for the life of the install. Same
         verdict, different arithmetic — so do not read the .NET 8 paragraph above as the live
         reason. Re-measure again at the next TFM bump; this is the second time the ground moved.

         The whole net8.0 -> net10.0 move cost 43.2 MB of exe (155.7 -> 112.5) and 1.7 s of first
         launch (5.1 -> 3.42) for free, before any setting was touched.

         WHY it got faster, and it is not the JIT: the exe NO LONGER EXTRACTS ANYTHING. Under
         net8.0 every new build wrote ~39 MB of native libraries into %TEMP%\.net\GritKeeper on
         its first run and Defender then scanned what came out; that extraction is what the
         first-launch figure was mostly measuring, and what made compression cost 13 seconds.
         Watched the cache directory across a cold launch of this build (2026-08-23): not one new
         folder appears. .NET 10 maps the native libraries out of the bundle in place.

         Two consequences, both acted on:
           - IncludeNativeLibrariesForSelfExtract is now a NO-OP. Published with it forced to
             false and the exe came out byte-identical to the default publish (SHA-256
             0574B1CA...5302 both ways), and that build opens its window in 1.31 s. So the
             REJECTED note above no longer reproduces — there is nothing left to extract for the
             setting to suppress. It stays set because the guard costs nothing and the failure it
             once caught was a silent one; it is no longer load-bearing.
           - The 400 MB disk requirement was sized for that %TEMP% spill. README.md,
             GK/source/README.md and the in-app System Requirements box (Menus.cs) now say
             250 MB and no longer promise an unpack that does not happen. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Dead code fails the build rather than waiting to be noticed. GK/.editorconfig turns four
         rules on as warnings — unused private member, private member written but never read, dead
         conditional branch, unnecessary using — and the verification pass builds with -warnaserror,
         so any of them stops a release. The 2026-07-30 sweep is what motivated it: a tracker sort
         mode the Keeper chose that was stored and never read back, a Ledger font minted on every
         zoom step and never drawn with, and a null check on the result of `new`. All three compiled
         clean and read as live code. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005 (unnecessary using) refuses to report unless the build generates XML docs, and
         says so as its own build error — so this cannot be Debug-only, as a first attempt had it:
         Release then failed on the demand instead of on any real finding. Docs are generated in
         every configuration and kept OUT of the publish output, so the single-file exe still ships
         alone with no loose GritKeeper.xml beside it. CS1591 off: this is an app, not a library,
         and an undocumented member is the norm here rather than an omission. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game's rules, and the JSON they read, now live in their own WinForms-free library
         (GK/rules) that this app and the smoke rig both reference. Everything in this project
         is the Windows UI on top of it. The Data\*.json embedding moved there with Core.cs,
         because Db.ReadData resolves resources off typeof(Db).Assembly — see that csproj.
         The published exe is still a true single-file standalone: PublishSingleFile bundles
         this DLL, and its embedded resources go with it. -->
    <ProjectReference Include="..\rules\BloodAndGrit.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- window/title-bar icon + the faint emblem watermark, loaded from the assembly so
         the single-file exe stays truly single-file. These stay here: they are the app's
         face, not the game's rules. -->
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="Assets\emblem.png" />
  </ItemGroup>

</Project>
