<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>SMOKE</DefineConstants>
    <!-- test rig only: run on whatever .NET runtime the machine has. It was load-bearing when the
         rig targeted net8.0 and this laptop had only the 9 runtime for console apps; since the
         net10.0 move (2026-08-23) the exact runtime is installed and this is belt-and-braces. It
         stays because it costs nothing and the failure it prevents — a rig that will not run on a
         machine one runtime ahead — is the kind nobody diagnoses quickly. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- Was a hand-listed <Compile Include="..\source\Foo.cs" /> for each of the six headless
         files, plus a copy of Data\*.json into the output for Db.ReadData's on-disk fallback.
         Both are gone: the six files are the rules library now, so this rig tests whatever that
         library contains rather than whatever someone remembered to list here, and the JSON is
         embedded in that assembly — which is the one typeof(Db).Assembly resolves to — so
         nothing needs copying beside the test binary. -->
    <ProjectReference Include="..\rules\BloodAndGrit.Rules.csproj" />
  </ItemGroup>
</Project>
