#!/bin/sh
# Keep every version claim in step with what is actually being committed.
#
# Regenerates README.md's AUTO block from the build scripts + CHANGELOG and patches the claims in
# CLAUDE.md and both app READMEs (see update_readme.py), then re-stages all four so the change
# rides along in this commit. Deliberately never blocks a commit: if Python is missing or the
# script errors, it warns and lets the commit through.
#
# Enabled per-clone with:  git config core.hooksPath .githooks
# (documented in CLAUDE.md; run it once after cloning).

py=python
command -v "$py" >/dev/null 2>&1 || py=python3
command -v "$py" >/dev/null 2>&1 || { echo "pre-commit: no python; skipping README refresh"; exit 0; }

"$py" update_readme.py || { echo "pre-commit: update_readme.py failed; committing anyway"; exit 0; }
# Every file update_readme.py can write. GritKeeper/README.md is the one that matters most and is
# the easiest to forget: it is the only tracked file in an otherwise generated folder, which is
# exactly how it came to sit twenty-three releases out of date.
for f in README.md CLAUDE.md GK/source/README.md GritKeeper/README.md; do
    git add "$f" 2>/dev/null || true
done
exit 0
